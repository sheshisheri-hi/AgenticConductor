# Python build artifacts — generated by pip install -e, safe to delete (make clean recreates them)
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Test / cache
.pytest_cache/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/

# Runtime artifacts
*.db
*.log
/tmp/

# Environment secrets — never commit
.env

# macOS
.DS_Store

# IDE
.vscode/settings.json
.idea/
