{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conductor Manifest",
  "description": "Declarative project configuration for Conductor multi-agent framework",
  "type": "object",
  "required": ["name", "description", "version", "author", "agents", "workflow"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Project name (e.g., 'aspen-sentinel')"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the project"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., '1.0.0')"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "email": {
          "type": ["string", "null"],
          "description": "Author email (optional)"
        }
      }
    },
    "license": {
      "type": "string",
      "default": "MIT",
      "description": "License (e.g., 'MIT', 'Apache-2.0')"
    },
    "agents": {
      "oneOf": [
        {
          "type": "string",
          "description": "Single agent directory path"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Multiple agent directory paths (multi-path support)"
        }
      ],
      "description": "Path(s) to agent module directories. Relative to conductor.json."
    },
    "workflow": {
      "type": "string",
      "description": "Path to workflow graph definition (YAML). Relative to conductor.json."
    },
    "filters": {
      "type": ["string", "null"],
      "description": "Path to filter rules definition (YAML). Optional, relative to conductor.json."
    },
    "routes": {
      "type": ["string", "null"],
      "description": "Path to routing rules definition (YAML). Optional, relative to conductor.json."
    },
    "hooks": {
      "type": ["string", "null"],
      "description": "Path to hooks configuration (JSON). Optional, relative to conductor.json."
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Enabled integrations (e.g., ['snyk', 'ado', 'github'])"
    },
    "disabled_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Agent class names to disable at runtime (e.g., ['NotifyAgent'])"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "If true, fail on any schema/config validation errors at startup"
    }
  },
  "additionalProperties": false
}
