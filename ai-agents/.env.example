# =============================================================================
# Conductor — Environment Configuration
# Copy this file to .env and fill in required values
# Run: cp .env.example .env
# =============================================================================

# --- LLM (required for sample/live mode) ---
# Token resolution order (first non-empty value wins):
#   CONDUCTOR_GITHUB_TOKEN → GITHUB_COPILOT_TOKEN → COPILOT_GITHUB_TOKEN → GITHUB_TOKEN
# Create a PAT with "copilot" scope: https://github.com/settings/tokens
# Verify setup with: conductor check
CONDUCTOR_GITHUB_TOKEN=               # preferred — most specific
# GITHUB_COPILOT_TOKEN=              # alias
# COPILOT_GITHUB_TOKEN=              # alias
# GITHUB_TOKEN=                      # fallback (used by many tools, lowest priority)

# --- Git operations (required for integration/live mode to push branches + open PRs) ---
# Must be a PAT with 'repo' scope — Copilot AI tokens are read-only and cannot push code.
# Create a classic PAT: https://github.com/settings/tokens (check 'repo' scope)
# Resolution: CONDUCTOR_GIT_TOKEN → CONDUCTOR_GITHUB_TOKEN → GITHUB_TOKEN
CONDUCTOR_GIT_TOKEN=                  # dedicated PAT for git push + PR creation (repo scope)

# --- Provider mode ---
CONDUCTOR_PROVIDER_MODE=mock          # mock (default, no token needed) | sample (real LLM + fixtures) | live (real LLM + real scanner APIs)

# --- LLM behavior ---
CONDUCTOR_LLM_MODEL=gpt-4.1
CONDUCTOR_MAX_LLM_RETRIES=3
CONDUCTOR_CONFIDENCE_THRESHOLD=0.80
CONDUCTOR_MAX_ENRICHMENT_ROUNDS=3

# --- Adversarial reviewer model ---
# Must differ from CONDUCTOR_LLM_MODEL so the critique is independent of the planning model.
# Approved models: gpt-4.1 | gpt-4.1-mini | gpt-4o | gpt-4-turbo | o1-preview | o3-mini
# Default is gpt-4o (intentionally different from the gpt-4.1 planner).
# CONDUCTOR_REVIEWER_MODEL=gpt-4o

# --- Execution gate (plan vs execute mode) ---
CONDUCTOR_CODE_EXECUTION_ENABLED=false   # false = plan mode only (safe default)
                                          # true = real git branch/commit/PR operations

# --- Logging ---
CONDUCTOR_LOG_LEVEL=INFO
CONDUCTOR_LOG_JSON=false              # false = colored console for dev, true = JSON for prod
CONDUCTOR_LOG_FILE=                   # optional: logs/conductor.log

# --- Workspace (used in execute mode for git clones) ---
CONDUCTOR_WORKSPACE_DIR=~/conductor-workspace

# --- Demo scenario (consumer-showcase only) ---
DEMO_SCENARIO=snyk                    # snyk | sonar | blackduck | ado-defect | ado-story

# =============================================================================
# Scanner tokens — only needed when CONDUCTOR_PROVIDER_MODE=live
# =============================================================================
# CONSUMER_SNYK_TOKEN=
# CONSUMER_SONAR_TOKEN=
# CONSUMER_SONAR_URL=https://sonarcloud.io
# CONSUMER_BLACKDUCK_TOKEN=
# CONSUMER_BLACKDUCK_URL=
# CONSUMER_ADO_PAT=
# CONSUMER_ADO_ORG=
# CONSUMER_ADO_PROJECT=

# --- ADO repo / org (for git operations in live mode) ---
# CONSUMER_ALLOWED_ORGS=github.com/myorg,dev.azure.com/myorg

# --- Observability (optional) ---
# CONDUCTOR_LANGSMITH_API_KEY=
# CONDUCTOR_LANGSMITH_PROJECT=conductor-dev

# =============================================================================
# Storage (result persistence)
# =============================================================================
# Dev default: SQLite file in current directory (no Docker needed)
CONDUCTOR_DB_URL=sqlite+aiosqlite:///conductor_runs.db

# Production: switch to Postgres (requires docker compose up postgres)
# CONDUCTOR_DB_URL=postgresql+asyncpg://conductor:conductor_dev@localhost:5435/conductor

# =============================================================================
# OpenTelemetry (optional — traces per stage/agent)
# =============================================================================
# CONDUCTOR_OTEL_ENDPOINT=http://localhost:4317    # Jaeger OTLP gRPC
# CONDUCTOR_OTEL_SERVICE_NAME=conductor            # service name in trace UIs
